# HTTP listen address
YU_ADDR=:8080
# Environment: development or production
YU_ENV=development
# SQLite file path
YU_DB_PATH=./data/yu-tasks.db
# Local-only role picker. Must remain disabled in production.
YU_DEV_LOGIN=0
# OIDC values are intentionally unset until the university provider is identified.
YU_OIDC_ISSUER=
YU_OIDC_CLIENT_ID=
YU_OIDC_CLIENT_SECRET=
